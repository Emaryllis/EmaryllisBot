{
  "name": "emaryllisbot",
  "version": "1.0.0",
  "description": "A Discord Bot for Emaryllis",
  "scripts": {
    "clean": "del /s /q build",
    "build": "tsc --build",
    "start": "npm run clean && npm run build && node build/index.js",
    "startNoClean": "npm run build && node build/index.js",
    "devStart": "npm run clean && npm run build && node build/index.js --development",
    "devStartNoClean": "npm run build && node build/index.js --development"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emaryllis/EmaryllisBot.git"
  },
  "keywords": [
    "discord.js",
    "discord"
  ],
  "author": "Emaryllis",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Emaryllis/EmaryllisBot/issues"
  },
  "homepage": "https://github.com/Emaryllis/EmaryllisBot#readme",
  "dependencies": {
    "discord.js": "^14.13.0",
    "dotenv": "^16.3.1",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
